{
  "entities": {
    "League": {
      "title": "League",
      "description": "A sports league or championship",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the league" },
        "logo": { "type": "string", "description": "URL to league logo" },
        "country": { "type": "string", "description": "Country of the league" }
      },
      "required": ["name"]
    },
    "Season": {
      "title": "Season",
      "description": "A specific season of a league",
      "type": "object",
      "properties": {
        "leagueId": { "type": "string" },
        "year": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "finished", "upcoming"] }
      },
      "required": ["leagueId", "year"]
    },
    "Team": {
      "title": "Team",
      "description": "A sports team",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "logo": { "type": "string" },
        "leagueId": { "type": "string" }
      },
      "required": ["name", "leagueId"]
    },
    "Player": {
      "title": "Player",
      "description": "A sport player",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "teamId": { "type": "string" },
        "position": { "type": "string" },
        "number": { "type": "number" },
        "imageUrl": { "type": "string" },
        "overview": { "type": "string" },
        "career": { "type": "string" },
        "transferHistory": { "type": "string" }
      },
      "required": ["name", "teamId"]
    },
    "Venue": {
      "title": "Venue",
      "description": "A match venue/stadium",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "city": { "type": "string" },
        "capacity": { "type": "number" }
      },
      "required": ["name"]
    },
    "MatchEvent": {
      "title": "Match Event",
      "description": "An event during a game",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["goal", "yellow", "red", "sub"] },
        "minute": { "type": "number" },
        "playerId": { "type": "string" },
        "assistantId": { "type": "string" },
        "playerInId": { "type": "string" },
        "playerOutId": { "type": "string" },
        "teamId": { "type": "string" }
      },
      "required": ["type", "minute", "playerId", "teamId"]
    },
    "Game": {
      "title": "Game",
      "description": "A match between two teams",
      "type": "object",
      "properties": {
        "leagueId": { "type": "string" },
        "seasonId": { "type": "string" },
        "homeTeamId": { "type": "string" },
        "awayTeamId": { "type": "string" },
        "homeScore": { "type": "number" },
        "awayScore": { "type": "number" },
        "status": { "type": "string", "enum": ["scheduled", "live", "finished"] },
        "date": { "type": "string", "format": "date-time" },
        "venueId": { "type": "string" },
        "attendance": { "type": "number" },
        "events": { "type": "array", "items": { "type": "object" } },
        "lineups": {
          "type": "object",
          "properties": {
            "home": { "type": "array", "items": { "type": "string" } },
            "away": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "required": ["leagueId", "homeTeamId", "awayTeamId", "date"]
    },
    "Administrator": {
      "title": "Administrator",
      "description": "A user with administrative privileges",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["super", "editor"] }
      },
      "required": ["email", "role"]
    },
    "Favorite": {
      "title": "Favorite Team",
      "description": "A team favorited by a user",
      "type": "object",
      "properties": {
        "teamId": { "type": "string" },
        "name": { "type": "string" },
        "logo": { "type": "string" }
      },
      "required": ["teamId"]
    },
    "Transfer": {
      "title": "Transfer",
      "description": "A player transfer between teams",
      "type": "object",
      "properties": {
        "playerId": { "type": "string" },
        "fromTeamId": { "type": "string" },
        "toTeamId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "fee": { "type": "string" },
        "type": { "type": "string", "enum": ["permanent", "loan", "free"] }
      },
      "required": ["playerId", "fromTeamId", "toTeamId", "date", "type"]
    }
  },
  "firestore": {
    "/leagues/{leagueId}": { "schema": "League", "description": "Global leagues" },
    "/leagues/{leagueId}/seasons/{seasonId}": { "schema": "Season", "description": "Seasons per league" },
    "/teams/{teamId}": { "schema": "Team", "description": "Teams in the system" },
    "/teams/{teamId}/players/{playerId}": { "schema": "Player", "description": "Players per team" },
    "/venues/{venueId}": { "schema": "Venue", "description": "Venues/Stadiums" },
    "/games/{gameId}": { "schema": "Game", "description": "All matches" },
    "/admins/{adminId}": { "schema": "Administrator", "description": "Authorized administrators" },
    "/users/{userId}/favorites/{favoriteId}": { "schema": "Favorite", "description": "User's favorite teams" },
    "/transfers/{transferId}": { "schema": "Transfer", "description": "Player transfers" }
  }
}
