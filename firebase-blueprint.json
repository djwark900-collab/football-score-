{
  "entities": {
    "Competition": {
      "title": "Competition",
      "description": "Top level competition categories",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "logo": { "type": "string" },
        "type": { "type": "string", "enum": ["league", "cup", "international"] }
      },
      "required": ["name", "type"]
    },
    "League": {
      "title": "League",
      "description": "A sports league or championship",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the league" },
        "logo": { "type": "string", "description": "URL to league logo" },
        "country": { "type": "string", "description": "Country of the league" },
        "competitionId": { "type": "string", "description": "ID of the parent competition" },
        "currentSeasonId": { "type": "string", "description": "ID of the current active season" }
      },
      "required": ["name"]
    },
    "Season": {
      "title": "Season",
      "description": "A specific season of a league",
      "type": "object",
      "properties": {
        "leagueId": { "type": "string" },
        "year": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "finished", "upcoming"] }
      },
      "required": ["leagueId", "year"]
    },
    "Team": {
      "title": "Team",
      "description": "A sports team",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "logo": { "type": "string" },
        "leagueId": { "type": "string" },
        "leagueId2": { "type": "string" },
        "coachName": { "type": "string" },
        "coachImageUrl": { "type": "string" },
        "foundedIn": { "type": "string" }
      },
      "required": ["name", "leagueId"]
    },
    "Player": {
      "title": "Player",
      "description": "A sport player",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "teamId": { "type": "string" },
        "position": { "type": "string" },
        "number": { "type": "number" },
        "imageUrl": { "type": "string" },
        "overview": { "type": "string" },
        "career": { "type": "string" },
        "transferHistory": { "type": "string" }
      },
      "required": ["name", "teamId"]
    },
    "Venue": {
      "title": "Venue",
      "description": "A match venue/stadium",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "city": { "type": "string" },
        "capacity": { "type": "number" }
      },
      "required": ["name"]
    },
    "MatchEvent": {
      "title": "Match Event",
      "description": "An event during a game",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["goal", "yellow", "red", "sub"] },
        "minute": { "type": "number" },
        "playerId": { "type": "string" },
        "assistantId": { "type": "string" },
        "playerInId": { "type": "string" },
        "playerOutId": { "type": "string" },
        "teamId": { "type": "string" }
      },
      "required": ["type", "minute", "playerId", "teamId"]
    },
    "Game": {
      "title": "Game",
      "description": "A match between two teams",
      "type": "object",
      "properties": {
        "leagueId": { "type": "string" },
        "leagueId2": { "type": "string" },
        "seasonId": { "type": "string" },
        "homeTeamId": { "type": "string" },
        "awayTeamId": { "type": "string" },
        "homeScore": { "type": "number" },
        "awayScore": { "type": "number" },
        "status": { "type": "string", "enum": ["scheduled", "live", "finished"] },
        "date": { "type": "string", "format": "date-time" },
        "venueId": { "type": "string" },
        "attendance": { "type": "number" },
        "round": { "type": "string", "description": "Match round (e.g. Round 1, Quarter Final)" },
        "events": { "type": "array", "items": { "type": "object" } },
        "lineups": {
          "type": "object",
          "properties": {
            "home": { "type": "array", "items": { "type": "string" } },
            "away": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "required": ["leagueId", "homeTeamId", "awayTeamId", "date"]
    },
    "Administrator": {
      "title": "Administrator",
      "description": "A user with administrative privileges",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["super", "editor"] }
      },
      "required": ["email", "role"]
    },
    "Favorite": {
      "title": "Favorite Team",
      "description": "A team favorited by a user",
      "type": "object",
      "properties": {
        "teamId": { "type": "string" },
        "name": { "type": "string" },
        "logo": { "type": "string" }
      },
      "required": ["teamId"]
    },
    "Transfer": {
      "title": "Transfer",
      "description": "A player transfer between teams",
      "type": "object",
      "properties": {
        "playerId": { "type": "string" },
        "fromTeamId": { "type": "string" },
        "toTeamId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "fee": { "type": "string" },
        "type": { "type": "string", "enum": ["permanent", "loan", "free"] }
      },
      "required": ["playerId", "fromTeamId", "toTeamId", "date", "type"]
    },
    "FantasyTeam": {
      "title": "Fantasy Team",
      "description": "A user's fantasy soccer team",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "budget": { "type": "number" },
        "totalPoints": { "type": "number" },
        "playerIds": { "type": "array", "items": { "type": "string" } },
        "benchPlayerIds": { "type": "array", "items": { "type": "string" } },
        "captainId": { "type": "string" },
        "viceCaptainId": { "type": "string" },
        "chips": {
          "type": "object",
          "properties": {
            "benchBoostUsed": { "type": "boolean" },
            "freeHitUsed": { "type": "boolean" },
            "tripleCaptainUsed": { "type": "boolean" }
          }
        }
      },
      "required": ["userId", "name", "playerIds"]
    },
    "MatchPrediction": {
      "title": "Match Prediction",
      "description": "A user's prediction for a match result",
      "type": "object",
      "properties": {
        "gameId": { "type": "string" },
        "userId": { "type": "string" },
        "prediction": { "type": "string", "enum": ["home", "draw", "away"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["gameId", "userId", "prediction"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Global profile for a user",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "xp": { "type": "number" },
        "level": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/competitions/{competitionId}": { "schema": "Competition", "description": "Top level competitions" },
    "/leagues/{leagueId}": { "schema": "League", "description": "Global leagues" },
    "/leagues/{leagueId}/seasons/{seasonId}": { "schema": "Season", "description": "Seasons per league" },
    "/teams/{teamId}": { "schema": "Team", "description": "Teams in the system" },
    "/teams/{teamId}/players/{playerId}": { "schema": "Player", "description": "Players per team" },
    "/venues/{venueId}": { "schema": "Venue", "description": "Venues/Stadiums" },
    "/games/{gameId}": { "schema": "Game", "description": "All matches" },
    "/admins/{adminId}": { "schema": "Administrator", "description": "Authorized administrators" },
    "/users/{userId}": { "schema": "UserProfile", "description": "Global user profiles" },
    "/users/{userId}/favorites/{favoriteId}": { "schema": "Favorite", "description": "User's favorite teams" },
    "/transfers/{transferId}": { "schema": "Transfer", "description": "Player transfers" },
    "/fantasyTeams/{userId}": { "schema": "FantasyTeam", "description": "User's fantasy team" },
    "/users/{userId}/predictions/{predictionId}": { "schema": "MatchPrediction", "description": "User's match predictions" }
  }
}
