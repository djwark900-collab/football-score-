rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives & Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email == 'pitop6988@gmail.com' && 
             request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validation Blueprints
    function isValidCompetition(data) {
      return data.keys().hasAll(['name', 'type']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.type in ['league', 'cup', 'international'] &&
             (!('logo' in data) || (data.logo is string && data.logo.size() <= 1000000));
    }

    function isValidLeague(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('logo' in data) || (data.logo is string && data.logo.size() <= 1000000)) &&
             (!('competitionId' in data) || (data.competitionId is string && (data.competitionId == "" || isValidId(data.competitionId)))) &&
             (!('country' in data) || (data.country is string && data.country.size() <= 100)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 5000)) &&
             (!('type' in data) || (data.type in ['league', 'cup'])) &&
             (!('history' in data) || (data.history is list)) &&
             (!('currentSeasonId' in data) || (data.currentSeasonId is string && (data.currentSeasonId == "" || isValidId(data.currentSeasonId))));
    }

    function isValidSeason(data) {
      return data.keys().hasAll(['leagueId', 'year', 'status']) &&
             data.leagueId is string && isValidId(data.leagueId) &&
             data.year is string && data.year.size() > 0 &&
             data.status in ['active', 'finished', 'upcoming'];
    }

    function isValidTeam(data) {
      return data.keys().hasAll(['name', 'leagueId']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.leagueId is string && isValidId(data.leagueId) &&
             (!('logo' in data) || (data.logo is string && data.logo.size() <= 1000000));
    }

    function isValidGame(data) {
      return data.keys().hasAll(['leagueId', 'homeTeamId', 'awayTeamId', 'date', 'status', 'homeScore', 'awayScore']) &&
             data.leagueId is string &&
             data.homeTeamId is string &&
             data.awayTeamId is string &&
             data.date is string &&
             data.status in ['scheduled', 'live', 'finished'] &&
             data.homeScore is number && data.homeScore >= 0 &&
             data.awayScore is number && data.awayScore >= 0 &&
             (!('events' in data) || data.events is list) &&
             (!('lineups' in data) || data.lineups is map);
    }

    function isValidAdministrator(data) {
      return data.keys().hasAll(['email', 'role']) &&
             data.email is string && data.email.size() > 0 &&
             data.role in ['super', 'editor'];
    }

    function isValidPlayer(data) {
      return data.keys().hasAll(['name', 'teamId', 'position', 'number']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.teamId is string && isValidId(data.teamId) &&
             data.position is string && data.position.size() <= 50 &&
             data.number is number &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2000)) &&
             (!('overview' in data) || (data.overview is string && data.overview.size() <= 5000)) &&
             (!('career' in data) || (data.career is string && data.career.size() <= 10000)) &&
             (!('transferHistory' in data) || (data.transferHistory is string && data.transferHistory.size() <= 10000));
    }

    function isValidVenue(data) {
      return data.keys().hasAll(['name', 'city', 'capacity']) &&
             data.name is string && data.name.size() > 0 &&
             data.city is string &&
             data.capacity is number;
    }

    function isValidTransfer(data) {
      return data.keys().hasAll(['playerId', 'fromTeamId', 'toTeamId', 'date', 'type']) &&
             isValidId(data.playerId) &&
             isValidId(data.fromTeamId) &&
             isValidId(data.toTeamId) &&
             data.date is string &&
             data.type in ['permanent', 'loan', 'free'] &&
             (!('fee' in data) || data.fee is string);
    }

    // Collection Rules
    match /test/connection {
      allow read: if true;
    }

    match /competitions/{competitionId} {
      allow read: if true;
      allow create: if isAdmin() && isValidCompetition(incoming());
      allow update: if isAdmin() && isValidCompetition(incoming());
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /transfers/{transferId} {
      allow read: if true;
      allow write: if isAdmin() && isValidTransfer(incoming());
    }

    match /leagues/{leagueId} {
      allow read: if true;
      allow create: if isAdmin() && isValidLeague(incoming());
      allow update: if isAdmin() && isValidLeague(incoming());
      allow delete: if isAdmin();

      match /seasons/{seasonId} {
        allow read: if true;
        allow write: if isAdmin() && isValidSeason(incoming());
      }
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create: if isAdmin() && isValidTeam(incoming());
      allow update: if isAdmin() && (
        // Action: Generic Update
        isValidTeam(incoming()) ||
        // Action: Patch (more robust)
        (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'logo', 'leagueId']))
      );
      allow delete: if isAdmin();
    }

    match /games/{gameId} {
      allow read: if true;
      allow create: if isAdmin() && isValidGame(incoming());
      allow update: if isAdmin() && (
        // Action: Update Score (Specific Action)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['homeScore', 'awayScore'])) ||
        // Action: Update Status
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) ||
        // Action: Full Update
        isValidGame(incoming())
      );
      allow delete: if isAdmin();
    }

    match /players/{playerId} {
      allow read: if true;
      allow create: if isAdmin() && isValidPlayer(incoming());
      allow update: if isAdmin() && isValidPlayer(incoming());
      allow delete: if isAdmin();
    }

    match /venues/{venueId} {
      allow read: if true;
      allow create: if isAdmin() && isValidVenue(incoming());
      allow update: if isAdmin() && isValidVenue(incoming());
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      
      match /favorites/{favoriteId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && 
                      incoming().keys().hasAll(['teamId']) &&
                      incoming().teamId is string &&
                      isValidId(incoming().teamId);
        allow update: if false; // Favorites are usually static refs
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
