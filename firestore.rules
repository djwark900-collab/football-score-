rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives & Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email == 'pitop6988@gmail.com' && 
             request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validation Blueprints
    function isValidCompetition(data) {
      return data.keys().hasAll(['name', 'type']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.type in ['league', 'cup', 'international'] &&
             (!('logo' in data) || (data.logo is string && data.logo.size() <= 1000000));
    }

    function isValidLeague(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('logo' in data) || (data.logo is string && data.logo.size() <= 1000000)) &&
             (!('competitionId' in data) || (data.competitionId is string && (data.competitionId == "" || isValidId(data.competitionId)))) &&
             (!('country' in data) || (data.country is string && data.country.size() <= 100)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 5000)) &&
             (!('type' in data) || (data.type in ['league', 'cup'])) &&
             (!('history' in data) || (data.history is list)) &&
             (!('currentSeasonId' in data) || (data.currentSeasonId is string && (data.currentSeasonId == "" || isValidId(data.currentSeasonId))));
    }

    function isValidSeason(data) {
      return data.keys().hasAll(['leagueId', 'year', 'status']) &&
             data.leagueId is string && isValidId(data.leagueId) &&
             data.year is string && data.year.size() > 0 &&
             data.status in ['active', 'finished', 'upcoming'];
    }

    function isValidTeam(data) {
      return data.keys().hasAll(['name', 'leagueId']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.leagueId is string && isValidId(data.leagueId) &&
             (!('leagueId2' in data) || (data.leagueId2 is string && (data.leagueId2 == "" || isValidId(data.leagueId2)))) &&
             (!('logo' in data) || (data.logo is string && data.logo.size() <= 1000000)) &&
             (!('coachName' in data) || (data.coachName is string && data.coachName.size() <= 100)) &&
             (!('coachImageUrl' in data) || (data.coachImageUrl is string && data.coachImageUrl.size() <= 1000000)) &&
             (!('foundedIn' in data) || (data.foundedIn is string && data.foundedIn.size() <= 20)) &&
             (!('marketValue' in data) || (data.marketValue is string && data.marketValue.size() <= 50)) &&
             (!('foreignPlayers' in data) || (data.foreignPlayers is number)) &&
             (!('nationalPlayers' in data) || (data.nationalPlayers is number)) &&
             (!('stadiumImageUrl' in data) || (data.stadiumImageUrl is string && data.stadiumImageUrl.size() <= 1000000));
    }

    function isValidGame(data) {
      return data.keys().hasAll(['leagueId', 'homeTeamId', 'awayTeamId', 'date', 'status', 'homeScore', 'awayScore']) &&
             data.leagueId is string &&
             (!('leagueId2' in data) || (data.leagueId2 is string && (data.leagueId2 == "" || isValidId(data.leagueId2)))) &&
             data.homeTeamId is string &&
             data.awayTeamId is string &&
             data.date is string &&
             data.status in ['scheduled', 'live', 'finished'] &&
             data.homeScore is number && data.homeScore >= 0 &&
             data.awayScore is number && data.awayScore >= 0 &&
             (!('events' in data) || data.events is list) &&
             (!('lineups' in data) || data.lineups is map);
    }

    function isValidAdministrator(data) {
      return data.keys().hasAll(['email', 'role']) &&
             data.email is string && data.email.size() > 0 &&
             data.role in ['super', 'editor'];
    }

    function isValidPlayer(data) {
      return data.keys().hasAll(['name', 'teamId', 'position', 'number']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.teamId is string && isValidId(data.teamId) &&
             data.position is string && data.position.size() <= 50 &&
             data.number is number &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2000)) &&
             (!('overview' in data) || (data.overview is string && data.overview.size() <= 5000)) &&
             (!('career' in data) || (data.career is string && data.career.size() <= 10000)) &&
             (!('transferHistory' in data) || (data.transferHistory is string && data.transferHistory.size() <= 10000));
    }

    function isValidVenue(data) {
      return data.keys().hasAll(['name', 'city', 'capacity']) &&
             data.name is string && data.name.size() > 0 &&
             data.city is string &&
             data.capacity is number;
    }

    function isValidTransfer(data) {
      return data.keys().hasAll(['playerId', 'fromTeamId', 'toTeamId', 'date', 'type']) &&
             isValidId(data.playerId) &&
             isValidId(data.fromTeamId) &&
             isValidId(data.toTeamId) &&
             data.date is string &&
             data.type in ['permanent', 'loan', 'free'] &&
             (!('fee' in data) || data.fee is string);
    }

    function isValidFantasyTeam(data) {
      return data.keys().hasAll(['userId', 'name', 'playerIds']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 50 &&
             data.playerIds is list &&
             (!('benchPlayerIds' in data) || data.benchPlayerIds is list) &&
             (!('captainId' in data) || data.captainId is string) &&
             (!('viceCaptainId' in data) || data.viceCaptainId is string) &&
             (!('budget' in data) || data.budget is number) &&
             (!('totalPoints' in data) || data.totalPoints is number) &&
             (!('chips' in data) || data.chips is map);
    }

    function isValidMatchPrediction(data) {
      return data.keys().hasAll(['gameId', 'userId', 'prediction']) &&
             data.gameId is string && isValidId(data.gameId) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.prediction in ['home', 'draw', 'away'] &&
             (!('timestamp' in data) || data.timestamp is string);
    }

    function isValidUserProfile(data) {
      return (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000000)) &&
             (!('xp' in data) || data.xp is number) &&
             (!('level' in data) || data.level is number);
    }

    // Collection Rules
    match /test/connection {
      allow read: if true;
    }

    match /competitions/{competitionId} {
      allow read: if true;
      allow create: if isAdmin() && isValidCompetition(incoming());
      allow update: if isAdmin() && isValidCompetition(incoming());
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read, list: if true; // Allow reading admins publicly for now to diagnose permission issues, and because it only contains emails.
      allow write: if isAdmin();
    }

    match /transfers/{transferId} {
      allow get, list, read: if true;
      allow write: if isAdmin() && isValidTransfer(incoming());
    }

    match /fantasyTeams/{userId} {
      allow get, list, read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId && isValidFantasyTeam(incoming());
    }

    match /leagues/{leagueId} {
      allow get, list, read: if true;
      allow create: if isAdmin() && isValidLeague(incoming());
      allow update: if isAdmin() && isValidLeague(incoming());
      allow delete: if isAdmin();

      match /seasons/{seasonId} {
        allow get, list, read: if true;
        allow write: if isAdmin() && isValidSeason(incoming());
      }
    }

    match /teams/{teamId} {
      allow get, list, read: if true;
      allow create: if isAdmin() && isValidTeam(incoming());
      allow update: if isAdmin() && (
        // Action: Generic Update
        isValidTeam(incoming()) ||
        // Action: Patch (more robust)
        (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'logo', 'leagueId', 'leagueId2', 'coachName', 'coachImageUrl', 'foundedIn', 'marketValue', 'foreignPlayers', 'nationalPlayers', 'stadiumImageUrl']))
      );
      allow delete: if isAdmin();
    }

    match /games/{gameId} {
      allow get, list, read: if true;
      allow create: if isAdmin() && isValidGame(incoming());
      allow update: if isAdmin() && (
        // Action: Update Score (Specific Action)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['homeScore', 'awayScore'])) ||
        // Action: Update Status
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) ||
        // Action: Patch (more robust)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leagueId', 'leagueId2', 'homeTeamId', 'awayTeamId', 'date', 'status', 'homeScore', 'awayScore', 'events', 'lineups', 'round', 'venueId', 'attendance'])) ||
        // Action: Full Update
        isValidGame(incoming())
      );
      allow delete: if isAdmin();
    }

    match /players/{playerId} {
      allow get, list, read: if true;
      allow create: if isAdmin() && isValidPlayer(incoming());
      allow update: if isAdmin() && isValidPlayer(incoming());
      allow delete: if isAdmin();
    }

    match /venues/{venueId} {
      allow get, list, read: if true;
      allow create: if isAdmin() && isValidVenue(incoming());
      allow update: if isAdmin() && isValidVenue(incoming());
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow get, list, read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId && isValidUserProfile(incoming());
      
      match /favorites/{favoriteId} {
        allow get, list, read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && 
                      incoming().keys().hasAll(['teamId']) &&
                      incoming().teamId is string &&
                      isValidId(incoming().teamId);
        allow update: if false; 
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /matchNotifications/{notificationId} {
        allow get, list, read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /predictions/{predictionId} {
        allow get, list, read: if isSignedIn() && request.auth.uid == userId;
        allow write: if isSignedIn() && request.auth.uid == userId && isValidMatchPrediction(incoming());
      }
    }
  }
}
