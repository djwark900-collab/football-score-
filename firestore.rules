rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- 1. Global Primitives ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isVerifiedUser() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- 2. Public Read Data (Competitions, Leagues, etc.) ---
    match /competitions/{compId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /leagues/{leagueId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /seasons/{seasonId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /players/{playerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /venues/{venueId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /transfers/{transferId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 3. User Data (Favorites, Notifications, Fantasy) ---
    function isValidFavorite(data) {
      return data.keys().hasAll(['teamId']) && 
             data.teamId is string && data.teamId.size() <= 128;
             // Optional fields name/logo are handled by the relaxed keys check
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['gameId']) && data.keys().size() == 1 &&
             data.gameId is string && data.gameId.size() <= 128;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && incoming().keys().size() <= 10;
      allow update: if isOwner(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'xp', 'level'])
      );

      match /favorites/{favId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidFavorite(incoming());
        allow update: if isOwner(userId) && isValidFavorite(incoming()) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'logo', 'teamId'])
        );
        allow delete: if isOwner(userId);
      }

      match /matchNotifications/{noteId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidNotification(incoming());
        allow delete: if isOwner(userId);
      }

      match /predictions/{predId} {
        allow list, get: if true;
        allow create: if isOwner(userId) && 
                      incoming().keys().hasAll(['gameId', 'prediction']) &&
                      incoming().prediction in ['home', 'draw', 'away'];
        allow delete: if isOwner(userId);
      }
    }

    match /fantasyTeams/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && incoming().keys().hasAll(['userId', 'name', 'playerIds']) && incoming().userId == userId;
      allow update: if isOwner(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'playerIds', 'budget', 'totalPoints', 'benchPlayerIds', 'captainId', 'viceCaptainId', 'chips'])
      ) && incoming().userId == existing().userId;
    }

    // --- 4. Admin Security ---
    match /admins/{adminId} {
      allow read: if isSignedIn(); // Allow checking for admin status
      allow write: if false; // Managed via console
    }
  }
}
